pkgname=tqftpserv
pkgver=1.3
pkgrel=2
pkgdesc="TFTP server for firmware transfer to Qualcomm remote subsystems over QRTR"
arch=('aarch64')
url="https://github.com/linux-msm/tqftpserv"
license=('BSD-3-Clause')
depends=('qrtr' 'zstd' 'systemd')
makedepends=('meson' 'ninja' 'pkgconf')
provides=('tqftpserv-git')
conflicts=('tqftpserv-git')
_commit=eb4b9a04ff92d2753ededf32cc3b6ed287f6e29b
_srcdir="tqftpserv-$_commit"
source=("$pkgname-$_commit.tar.gz::https://github.com/linux-msm/tqftpserv/archive/$_commit.tar.gz")
sha256sums=('SKIP')

build() {
	cd "$srcdir/$_srcdir"
	arch-meson . build
	meson compile -C build
}

package() {
	cd "$srcdir/$_srcdir"
	meson install -C build --destdir "$pkgdir"
}
