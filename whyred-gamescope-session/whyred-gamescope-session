#!/bin/sh
# whyred-gamescope-session - Gamescope as a Wayland login session.
#
# Started by the display manager.  Gamescope takes over the DRM output and
# launches a gamepad-friendly client (RetroArch by default).  A client can be
# selected in /etc/whyred-gamescope-session.conf or
# ~/.config/whyred-gamescope-session.conf.
set -eu

: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR must be set by the session manager}"

CONF=/etc/whyred-gamescope-session.conf
[ -r "$CONF" ] && . "$CONF"
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/whyred-gamescope-session.conf"
[ -r "$USER_CONF" ] && . "$USER_CONF"

pick_app() {
	if [ -n "${GAMESCOPE_SESSION_APP:-}" ]; then
		printf '%s\n' "$GAMESCOPE_SESSION_APP"
	elif command -v retroarch >/dev/null 2>&1; then
		printf '%s\n' 'retroarch --menu'
	elif command -v moonlight-qt >/dev/null 2>&1; then
		printf '%s\n' 'moonlight-qt'
	else
		printf '%s\n' 'sh -c "echo Install retroarch or moonlight-qt for a gamepad UI.; sleep 30"'
	fi
}

APP="$(pick_app)"
ORIENT="${GAMESCOPE_SESSION_ORIENTATION:-left}"
WIDTH="${GAMESCOPE_SESSION_WIDTH:-1920}"
HEIGHT="${GAMESCOPE_SESSION_HEIGHT:-1080}"

LOG="${XDG_RUNTIME_DIR}/whyred-gamescope-session.log"
exec >"$LOG" 2>&1

echo "whyred-gamescope-session: app=$APP orientation=$ORIENT size=${WIDTH}x${HEIGHT}"

# Force compositor rotation: the msm DRM driver does not expose a usable
# rotation property on all kernels, and Gamescope's plane rotation path is
# fragile on a5xx.
exec gamescope \
	--backend=drm \
	--force-orientation "$ORIENT" \
	--force-composition-rotation \
	--force-windows-fullscreen \
	-W "$WIDTH" -H "$HEIGHT" \
	-- sh -c "$APP"
