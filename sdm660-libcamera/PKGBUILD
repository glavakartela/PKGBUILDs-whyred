# AutoUpdate: sdm660-mainline/libcamera sdm660-sensors
pkgname=sdm660-libcamera
pkgver=0.8.0
_commit=1cf91b810f117a1738297b9bf72f2f5a5a7172d8
pkgrel=1
pkgdesc="libcamera with SDM660 sensor properties (whyred camera stack)"
arch=('aarch64')
url="https://github.com/sdm660-mainline/libcamera"
license=('LGPL-2.1-or-later' 'GPL-2.0-or-later')
depends=(
	'glibc'
	'libdrm'
	'libevent'
	'libgcc'
	'libstdc++'
	'libyaml'
	'openssl'
	'systemd-libs'
)

makedepends=(
	'meson'
	'ninja'
	'python-jinja'
	'python-ply'
	'python-yaml'
	'systemd-libs'
)
provides=('libcamera' 'libcamera-whyred')
conflicts=('libcamera' 'libcamera-whyred')
source=("libcamera-whyred::git+https://github.com/sdm660-mainline/libcamera.git#commit=$_commit")
sha256sums=('SKIP')

build() {
	cd libcamera-whyred
	meson setup build . \
		--buildtype=release \
		-Dpipelines=simple \
		-Dipas=softisp \
		-Dv4l2=enabled \
		-Dgstreamer=disabled \
		-Dqcam=disabled \
		-Dpycamera=disabled \
		-Ddocumentation=disabled \
		-Dtest=false \
		-Dwerror=false
	meson compile -C build
}

package() {
	cd libcamera-whyred
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
}
