# Maintainer: Kulesha Evgeniy
# AutoUpdate: linux-msm/rmtfs master
pkgname=rmtfs
pkgver=20260909
pkgrel=2
pkgdesc="Qualcomm remote filesystem service - gives the modem access to shared memory / EFS storage"
arch=('aarch64')
url="https://github.com/linux-msm/rmtfs"
license=('BSD-3-Clause')
depends=('qrtr' 'systemd-libs')
_efspath=/var/lib/rmtfs
_commit=b30a3eb38f9af283f18dbd3c7755653efc52c094
_srcdir="rmtfs-$_commit"
source=("$pkgname-$_commit.tar.gz::https://github.com/linux-msm/rmtfs/archive/$_commit.tar.gz")
sha256sums=('SKIP')

build() {
	cd "$srcdir/$_srcdir"
	make RMTFS_EFS_PATH="$_efspath" prefix=/usr rmtfs rmtfs.service rmtfs-dir.service
}

package() {
	cd "$srcdir/$_srcdir"
	install -Dm755 rmtfs "$pkgdir/usr/bin/rmtfs"
	install -Dm644 rmtfs.service -t "$pkgdir/usr/lib/systemd/system"
	install -Dm644 rmtfs-dir.service -t "$pkgdir/usr/lib/systemd/system"
	install -Dm644 rmtfs.rules -t "$pkgdir/usr/lib/udev/rules.d"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	install -dm755 "$pkgdir$_efspath"
}
