# Maintainer: Kulesha Evgeniy
# AutoUpdate: glavakartela/whyred-mainline 7.2-cpu-osm
pkgname=sdm660-linux-whyred
pkgver=7.2.3
pkgrel=20261122140712
pkgdesc="Linux kernel for Xiaomi Redmi Note 5 Pro (whyred) from the whyred-mainline fork"
arch=('aarch64')
url="https://github.com/glavakartela/whyred-mainline"
license=('GPL2')
options=('!strip')
provides=('linux-qcom-sdm636-whyred')
conflicts=('sdm660-linux' 'linux-qcom-sdm636-whyred')
replaces=('linux-qcom-sdm636-whyred')
makedepends=(
	'bc'
	'bison'
	'clang'
	'flex'
	'lld'
	'llvm'
	'openssl'
	'perl'
	'python'
	'uboot-tools'
	'zstd'
)
_commit=9c7be88a099fccffb1a48868b858f82cc4828aaf
_srcdir="whyred-mainline-$_commit"
_flavor=sdm660-whyred
source=(
	"whyred-mainline-$_commit.tar.gz::https://github.com/glavakartela/whyred-mainline/archive/$_commit.tar.gz"
	"$pkgname.preset"
	config-sdm660-linux-whyred.aarch64
)
sha256sums=('SKIP' 'SKIP' 'd58fa189bcc41feb1032d5922e951f762e1db58686b55b1f51e3505d46779036')
install="$pkgname.install"

prepare() {
	cd "$srcdir/$_srcdir"
	if [ -f "$srcdir/config-sdm660-linux-whyred.aarch64" ]; then
		cp "$srcdir/config-sdm660-linux-whyred.aarch64" .config
	elif ! make ARCH=arm64 LLVM=1 whyred_defconfig; then
		make ARCH=arm64 LLVM=1 sdm660_defconfig
	fi
	make ARCH=arm64 LLVM=1 olddefconfig
}

build() {
	cd "$srcdir/$_srcdir"
	unset LDFLAGS
	make ARCH=arm64 LLVM=1 \
		KBUILD_BUILD_VERSION="$pkgrel-$_flavor" \
		all Image.gz dtbs
}

package() {
	cd "$srcdir/$_srcdir"

	make ARCH=arm64 LLVM=1 \
		modules_install \
		INSTALL_MOD_PATH="$pkgdir/usr" \
		INSTALL_MOD_STRIP=1

	_kernver="$(cat include/config/kernel.release)"
	rm -f "$pkgdir/usr/lib/modules/$_kernver"/{build,source}

	install -Dm644 arch/arm64/boot/Image.gz \
		"$pkgdir/boot/Image.gz-whyred"

	for _dtb in arch/arm64/boot/dts/qcom/sdm636-xiaomi-whyred-*.dtb; do
		[ -f "$_dtb" ] || continue
		install -Dm644 "$_dtb" \
			"$pkgdir/boot/dtbs/whyred/$(basename "$_dtb")"
	done

	install -Dm644 include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$pkgname/kernel.release"

	install -Dm644 "$srcdir/$pkgname.preset" \
		"$pkgdir/etc/mkinitcpio.d/$pkgname.preset"
	sed -i "s/@KVER@/$_kernver/" \
		"$pkgdir/etc/mkinitcpio.d/$pkgname.preset"
}
