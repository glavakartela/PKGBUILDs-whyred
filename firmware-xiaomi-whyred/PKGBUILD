# Maintainer: Kulesha Evgeniy
pkgname=firmware-xiaomi-whyred
pkgver=6
pkgrel=3
pkgdesc="Firmware files for Xiaomi Redmi Note 5 Pro (whyred)"
url="https://postmarketos.org"
arch=('aarch64')
license=('custom:proprietary')
options=('!strip')
_commit="a00c3503abab8becfc742077ad00a48060fb15d3"
source=(
	"$pkgname-$_commit.tar.gz::https://github.com/glavakartela/postmarketos-vendor-xiaomi-whyred/archive/$_commit.tar.gz"
	"ath10k-fw-features.py"
	"sns.reg-xiaomi,whyred-shenchao"
)
sha256sums=(
	'SKIP'
	'bd6d49fb29c677a730fa8b836233c2239d98ee3c81cd428fa877b99c25844497'
	'64db548bac4818d4b0230e04cebe092294e9857fd49159828305e2a869ed7343'
)

prepare() {
	cd "postmarketos-vendor-xiaomi-whyred-$_commit"

	# WCN3990 loads its firmware externally (NON_BMI), so firmware-5.bin is
	# only a metadata container.  Set the feature bits that make ath10k work
	# around the firmware bugs fixed in the 7.4 whyred branch:
	#   23 ATH10K_FW_FEATURE_NO_CHAN_STAT_EVENT
	#   24 ATH10K_FW_FEATURE_NO_QUIET_MODE
	#   25 ATH10K_FW_FEATURE_PASSIVE_SCAN_5GHZ
	python3 "$srcdir/ath10k-fw-features.py" \
		ath10k/WCN3990/hw1.0/firmware-5.bin 23 24 25
}

package() {
	cd "postmarketos-vendor-xiaomi-whyred-$_commit"
	_fwdir="$pkgdir/usr/lib/firmware"

	# --- ath10k Wi-Fi (WCN3990) ---
	install -Dm644 ath10k/WCN3990/hw1.0/firmware-5.bin \
		-t "$_fwdir/ath10k/WCN3990/hw1.0/"
	install -Dm644 ath10k/WCN3990/hw1.0/board-2.bin \
		-t "$_fwdir/ath10k/WCN3990/hw1.0/"

	# --- GPU ZAP shader (Adreno 512) ---
	install -Dm644 qcom/a512_zap.elf \
		"$_fwdir/postmarketos/a512_zap.mbn"

	# --- ADSP ---
	install -Dm644 adspr.jsn  -t "$_fwdir/qcom/"
	install -Dm644 adsps.jsn  -t "$_fwdir/qcom/"
	install -Dm644 adspua.jsn -t "$_fwdir/qcom/"
	install -Dm644 adsp.mbn   -t "$_fwdir/qcom/"
	# The mainline PAS driver asks for the split .mdt name; the vendor image
	# is a monolithic ELF .mbn, which qcom_mdt_load can load as-is.
	ln -sf adsp.mbn "$_fwdir/qcom/adsp.mdt"

	# --- Modem ---
	install -Dm644 modemr.jsn  -t "$_fwdir/qcom/"
	install -Dm644 modemuw.jsn -t "$_fwdir/qcom/"
	install -Dm644 modem.mbn   -t "$_fwdir/qcom/"
	ln -sf modem.mbn "$_fwdir/qcom/modem.mdt"

	# --- Sensor registry (ADSP SSC) ---
	install -Dm644 "$srcdir/sns.reg-xiaomi,whyred-shenchao" \
		"$_fwdir/qcom/sensors/sns.reg-xiaomi,whyred-shenchao"
	for _panel in huaxing-nt36672 tianma tianma-nt36672; do
		ln -sf "sns.reg-xiaomi,whyred-shenchao" \
			"$_fwdir/qcom/sensors/sns.reg-xiaomi,whyred-$_panel"
	done

	# --- MBA / WLAN / QDSP6 ---
	install -Dm644 mba.mbn      -t "$_fwdir/qcom/"
	install -Dm644 wlanmdsp.mbn -t "$_fwdir/qcom/"
	install -Dm644 qdsp6m.qdb   -t "$_fwdir/qcom/"

	# --- Speaker amp ---
	find speakeramp -type f | while read -r f; do
		install -Dm644 "$f" "$_fwdir/$f"
	done

	# --- QCA Bluetooth ---
	find qca -type f | while read -r f; do
		install -Dm644 "$f" "$_fwdir/$f"
	done

	# --- everything else under qcom/ ---
	find qcom -type f ! -name "a512_zap.elf" | while read -r f; do
		install -Dm644 "$f" "$_fwdir/$f"
	done
}
