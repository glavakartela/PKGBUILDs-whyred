# Maintainer: Kulesha Evgeniy
pkgname=linux-qcom-sdm636-whyred
pkgver=7.2.3
pkgrel=1
pkgdesc="Close-to-mainline Linux kernel for Xiaomi Redmi Note 5 Pro (whyred, SDM636)"
arch=('aarch64')
url="https://github.com/glavakartela/whyred-mainline"
license=('GPL2')
options=('!strip')
makedepends=(
	'bc'
	'bison'
	'clang'
	'flex'
	'lld'
	'llvm'
	'openssl'
	'perl'
	'python'
	'uboot-tools'
	'zstd'
)
_commit="4b44def9116fe59b43600223e8a1b0eaa741c8c0"
_carch=arm64
_flavor=qcom-sdm636-whyred
source=(
	"whyred-mainline-$_commit.tar.gz::https://github.com/glavakartela/whyred-mainline/archive/$_commit.tar.gz"
	linux-qcom-sdm636-whyred.preset
	# config-qcom-sdm636-whyred.aarch64
)
sha256sums=('SKIP'
            'SKIP')
install=linux-qcom-sdm636-whyred.install

prepare() {
	cd "whyred-mainline-$_commit"
	if [ -f "$srcdir/config-qcom-sdm636-whyred.aarch64" ]; then
		cp -v "$srcdir/config-qcom-sdm636-whyred.aarch64" .config
	else
		make ARCH="$_carch" LLVM=1 whyred_defconfig
	fi
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	cd "whyred-mainline-$_commit"
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$pkgrel-$_flavor" \
		all Image.gz dtbs
}

package() {
	cd "whyred-mainline-$_commit"

	make ARCH="$_carch" LLVM=1 \
		modules_install \
		INSTALL_MOD_PATH="$pkgdir/usr" \
		INSTALL_MOD_STRIP=1

	_kernver="$(cat include/config/kernel.release)"
	rm -f "$pkgdir/usr/lib/modules/$_kernver"/{build,source}

	install -Dm644 arch/arm64/boot/Image.gz \
		"$pkgdir/boot/Image.gz-whyred"

	install -Dm644 \
		arch/arm64/boot/dts/qcom/sdm636-xiaomi-whyred-shenchao-td4310.dtb \
		"$pkgdir/boot/dtbs/whyred/sdm636-xiaomi-whyred-shenchao-td4310.dtb"
	install -Dm644 \
		arch/arm64/boot/dts/qcom/sdm636-xiaomi-whyred-tianma-td4310.dtb \
		"$pkgdir/boot/dtbs/whyred/sdm636-xiaomi-whyred-tianma-td4310.dtb"

	install -Dm644 include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	install -Dm644 "$srcdir/linux-qcom-sdm636-whyred.preset" \
		"$pkgdir/etc/mkinitcpio.d/linux-qcom-sdm636-whyred.preset"
}
