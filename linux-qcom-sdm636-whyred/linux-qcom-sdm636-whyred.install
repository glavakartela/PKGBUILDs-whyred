post_install() {
	echo ">>> Building initramfs, see mkinitcpio output above for errors."
	# See the CAVEAT comment in linux-qcom-sdm636-whyred.preset if this
	# fails to autodetect the kernel version from the compressed Image.gz.
	mkinitcpio -p linux-qcom-sdm636-whyred
}

post_upgrade() {
	post_install
}

pre_remove() {
	rm -f /boot/initramfs-whyred.img
}
