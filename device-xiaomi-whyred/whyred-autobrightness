#!/bin/sh
# Adjust the whyred panel backlight from the LTR578 ambient light sensor.
#
# The sensor is sampled several times and reduced with a median, the new
# target must persist for HOLD_SECS before it is applied, and the applied
# value moves toward the target in bounded steps.  This keeps a passing
# shadow or a single noisy sample from flashing the panel.
set -u

CONF=/etc/whyred-autobrightness.conf
[ -r "$CONF" ] && . "$CONF"

: "${ENABLED:=1}"
: "${MIN_BRIGHTNESS:=300}"
: "${MAX_BRIGHTNESS:=4095}"
: "${INTERVAL:=2}"
: "${SAMPLE_COUNT:=3}"
: "${SAMPLE_DELAY:=0.2}"
: "${HOLD_SECS:=2}"
: "${CURVE_DIVISOR:=3.2}"
: "${USE_KDE_BRIGHTNESS:=0}"
: "${FADE_MS:=700}"
: "${MIN_DELTA:=40}"
: "${MAX_STEP:=800}"
: "${SYNC_DELTA:=200}"

bl=/sys/class/backlight/backlight
fade=/usr/local/bin/whyred-backlight-fade

find_light() {
	for d in /sys/bus/iio/devices/iio:device*; do
		[ -r "$d/name" ] || continue
		[ "$(cat "$d/name" 2>/dev/null)" = "qcom-smgr-prox" ] || continue
		printf '%s\n' "$d"
		return 0
	done
	return 1
}

read_raw() {
	timeout 2 cat "$1/in_illuminance_raw" 2>/dev/null
}

clamp() {
	val=$1
	[ "$val" -lt "$MIN_BRIGHTNESS" ] && val=$MIN_BRIGHTNESS
	[ "$val" -gt "$MAX_BRIGHTNESS" ] && val=$MAX_BRIGHTNESS
	printf '%s\n' "$val"
}

sync_kde_brightness() {
	[ "$USE_KDE_BRIGHTNESS" = 1 ] || return 0
	val=$1
	max=$(cat "$bl/max_brightness" 2>/dev/null) || return 0
	[ -n "$max" ] && [ "$max" -gt 0 ] || return 0
	kde=$(( (val * 10000 + max / 2) / max ))
	sid=$(loginctl list-sessions --no-legend 2>/dev/null |
		awk '$4 == "seat0" { print $1; exit }')
	[ -n "$sid" ] || return 0
	user=$(loginctl show-session "$sid" -p Name --value 2>/dev/null)
	uid=$(loginctl show-session "$sid" -p User --value 2>/dev/null)
	[ -n "$user" ] && [ -n "$uid" ] || return 0
	runuser -u "$user" -- env \
		XDG_RUNTIME_DIR="/run/user/$uid" \
		DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
		busctl --user call org.kde.ScreenBrightness \
		/org/kde/ScreenBrightness/display0 \
		org.kde.ScreenBrightness.Display \
		SetBrightness iu "$kde" 0 >/dev/null 2>&1 || true
}

applied=-1
pending=
pending_since=0
last_synced=-1

while :; do
	[ -r "$CONF" ] && . "$CONF"

	if [ "$ENABLED" != 1 ]; then
		pending=
		applied=-1
		sleep "$INTERVAL"
		continue
	fi

	if [ "$(cat "$bl/bl_power" 2>/dev/null || echo 0)" != 0 ]; then
		# The panel is blanked; actual_brightness reads as 0.  Re-arm
		# so the first visible frame starts from the requested level.
		pending=
		applied=-1
		sleep "$INTERVAL"
		continue
	fi

	dev=$(find_light) || { sleep 5; continue; }

	samples=
	i=0
	while [ "$i" -lt "$SAMPLE_COUNT" ]; do
		raw=$(read_raw "$dev") || break
		case "$raw" in
		''|*[!0-9]*) break ;;
		esac
		samples="$samples $raw"
		i=$((i + 1))
		[ "$i" -lt "$SAMPLE_COUNT" ] && sleep "$SAMPLE_DELAY"
	done
	[ -n "$samples" ] || { sleep "$INTERVAL"; continue; }

	median=$(printf '%s\n' $samples | sort -n |
		sed -n "$(( (i + 1) / 2 ))p")
	case "$median" in
	''|*[!0-9]*) sleep "$INTERVAL"; continue ;;
	esac

	target=$(awk -v r="$median" -v min="$MIN_BRIGHTNESS" \
		-v max="$MAX_BRIGHTNESS" -v div="$CURVE_DIVISOR" 'BEGIN {
			l = r / 65536.0;
			if (l < 1) l = 1;
			p = log(l) / log(10) / div;
			if (p < 0) p = 0;
			if (p > 1) p = 1;
			printf "%d", min + (max - min) * p;
		}')
	target=$(clamp "$target")

	if [ "$applied" -lt 0 ]; then
		cur=$(cat "$bl/brightness" 2>/dev/null || echo "$target")
		case "$cur" in
		''|*[!0-9]*) cur=$target ;;
		esac
		applied=$(clamp "$cur")
	fi

	now=$(date +%s)
	if [ -z "$pending" ] ||
	   [ "$target" -ge $((pending + MIN_DELTA)) ] ||
	   [ "$target" -le $((pending - MIN_DELTA)) ]; then
		pending=$target
		pending_since=$now
	fi

	if [ $((now - pending_since)) -lt "$HOLD_SECS" ]; then
		sleep "$INTERVAL"
		continue
	fi

	delta=$((pending - applied))
	if [ "$delta" -gt "$MAX_STEP" ]; then
		delta=$MAX_STEP
	elif [ "$delta" -lt $((0 - MAX_STEP)) ]; then
		delta=$((0 - MAX_STEP))
	fi
	new=$(clamp $((applied + delta)))

	if [ "$new" -eq "$applied" ]; then
		sleep "$INTERVAL"
		continue
	fi

	if [ -x "$fade" ]; then
		"$fade" "$new" "$FADE_MS" || true
	else
		printf '%s\n' "$new" > "$bl/brightness" 2>/dev/null || true
	fi
	applied=$new

	if [ "$applied" -eq "$pending" ] && [ "$USE_KDE_BRIGHTNESS" = 1 ]; then
		sync_delta=$((applied > last_synced ?
			applied - last_synced : last_synced - applied))
		if [ "$last_synced" -lt 0 ] || [ "$sync_delta" -ge "$SYNC_DELTA" ]; then
			sync_kde_brightness "$applied"
			last_synced=$applied
		fi
	fi

	sleep "$INTERVAL"
done
