build() {
	cd "$srcdir/msm-modem-13"
	arch-meson . build \
		-Dopenrc=false \
		-Dsystemd=true \
		-Duim-selection=true \
		-Dwwan-port=true \
		-Ddownstream=false
	meson compile -C build
	cd "$srcdir"

	cd "q6voiced-$_q6voicedver"
	arch-meson . build -Dopenrc=disabled -Dsystemd=enabled
	meson compile -C build
}

package() {
	cd "$srcdir/msm-modem-13"
	meson install -C build --destdir "$pkgdir"
	cd "$srcdir"

	cd "q6voiced-$_q6voicedver"
	meson install -C build --destdir "$pkgdir"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.q6voiced"
	cd "$srcdir"

	cd "swclock-offset-$_swclockver"
	make DESTDIR="$pkgdir" prefix=/usr bin systemd
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.swclock-offset"
	cd "$srcdir"

	install -d "$pkgdir/usr/share/alsa"
	cp -r "alsa-ucm-conf-$_alsaucm_commit/ucm2" "$pkgdir/usr/share/alsa/"

	install -Dm644 UPower.conf \
		"$pkgdir/etc/UPower/UPower.conf"

	install -Dm644 51-qcom.conf \
		-t "$pkgdir/usr/share/wireplumber/wireplumber.conf.d"

	install -Dm644 50-soc-qcom-gstreamer.conf \
		-t "$pkgdir/usr/lib/environment.d"

	install -Dm755 sdm660-adreno-quirks.sh \
		-t "$pkgdir/etc/profile.d"

	install -Dm755 call-audio-idle-suspend-workaround.sh \
		"$pkgdir/usr/bin/call_audio_idle_suspend_workaround"
	install -Dm644 call-audio-idle-suspend-workaround.service \
		-t "$pkgdir/usr/lib/systemd/user"

	install -Dm644 modem-gnss.service \
		-t "$pkgdir/usr/lib/systemd/system"

	install -Dm644 20-imagis-input.rules \
		-t "$pkgdir/usr/lib/udev/rules.d"
	install -Dm644 20-tm2-touchkey-input.rules \
		-t "$pkgdir/usr/lib/udev/rules.d"
	install -Dm644 20-tm2-touchkey-leds.rules \
		-t "$pkgdir/usr/lib/udev/rules.d"
	install -Dm644 20-zinitix-input.rules \
		-t "$pkgdir/usr/lib/udev/rules.d"

	install -Dm755 msm-firmware-loader.sh \
		"$pkgdir/usr/bin/msm-firmware-loader.sh"
	install -Dm644 msm-firmware-loader.service \
		-t "$pkgdir/usr/lib/systemd/system"
	install -Dm755 msm-firmware-loader-unpack.sh \
		"$pkgdir/usr/bin/msm-firmware-loader-unpack.sh"
	install -Dm644 msm-firmware-loader-unpack.service \
		-t "$pkgdir/usr/lib/systemd/system"
	install -Dm644 msm-firmware-loader-LICENSE \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE.msm-firmware-loader"

	install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
	ln -s ../msm-firmware-loader.service \
		"$pkgdir/usr/lib/systemd/system/sysinit.target.wants/msm-firmware-loader.service"
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../msm-firmware-loader-unpack.service \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/msm-firmware-loader-unpack.service"

	install -Dm644 extlinux.conf.example \
		-t "$pkgdir/usr/share/doc/$pkgname/"
	install -Dm644 mkinitcpio-modules.md \
		-t "$pkgdir/usr/share/doc/$pkgname/"
}
