pkgname=device-xiaomi-whyred
pkgver=5
pkgrel=5
pkgdesc="Configuration for Xiaomi Redmi Note 5 Pro"
url="https://postmarketos.org"
arch=('aarch64')
license=('MIT' 'BSD-3-Clause' 'GPL-3.0-or-later')
depends=(
	'firmware-xiaomi-whyred'
	'sdm660-linux-whyred'
	'systemd'
	'libqmi'
	'qrtr'
	'pd-mapper'
	'rmtfs'
	'tqftpserv'
	'swclock-offset'
	'modemmanager'
	'networkmanager'
	'sudo'
)

provides=('alsa-ucm-conf')
conflicts=('alsa-ucm-conf')
optdepends=(
	'msm-modem: UIM selection and WWAN port helpers'
	'q6voiced: Q6Voice call audio routing'
	'qcom-diag: Qualcomm diag logging'
	'qbootctl: bootloader control'
	'python: provider-database APN fallback'
	'mobile-broadband-provider-info: provider-database APN fallback'
	'ofono: alternative to modemmanager for q6voiced call signalling'
	'pipewire-pulse: required for the call-audio-idle-suspend-workaround service'
	'vulkan-icd-loader: Vulkan support for the freedreno GPU driver'
)

makedepends=('gcc')
backup=(
	'etc/UPower/UPower.conf.d/70-whyred.conf'
	'usr/share/wireplumber/wireplumber.conf.d/51-qcom.conf'
	'usr/lib/environment.d/50-soc-qcom-gstreamer.conf'
	'etc/whyred-autobrightness.conf'
	'etc/whyred-cell.conf'
)
options=('!strip')
_alsaucm_commit="d64f7831da66e053dbd80e1c387763e191f77173"
source=(
	"alsa-ucm-conf-$_alsaucm_commit.tar.gz::https://github.com/sdm660-mainline/alsa-ucm-conf/archive/$_alsaucm_commit.tar.gz"
	70-whyred.conf
	51-qcom.conf
	50-soc-qcom-gstreamer.conf
	sdm660-adreno-quirks.sh
	call-audio-idle-suspend-workaround.sh
	call-audio-idle-suspend-workaround.service
	modem-gnss.service
	20-imagis-input.rules
	20-tm2-touchkey-input.rules
	20-tm2-touchkey-leds.rules
	20-zinitix-input.rules
	msm-firmware-loader.sh
	msm-firmware-loader.service
	msm-firmware-loader-unpack.sh
	msm-firmware-loader-unpack.service
	msm-firmware-loader-LICENSE
	extlinux.conf.example
	mkinitcpio-modules.md
	whyred-uim-select
	whyred-uim-select.service
	whyred-modem-uim.conf
	whyred-sim-hotplug
	whyred-sim-hotplug.service
	whyred-autobrightness
	whyred-autobrightness.conf
	whyred-autobrightness.service
	whyred-backlight-fade.c
	whyred-cell
	whyred-cell.conf
	whyred-cell.service
	whyred-apn
	ipa-helper
	whyred-cell-toggle
	whyred-cell-sudoers
)
