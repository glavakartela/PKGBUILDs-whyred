pkgname=qrtr
pkgver=1.2
pkgrel=2
pkgdesc="Qualcomm IPC router userspace library and tools (qrtr-cfg, qrtr-lookup)"
arch=('aarch64')
url="https://github.com/linux-msm/qrtr"
license=('BSD-3-Clause')
makedepends=('meson' 'ninja')
_commit=29e36ae164389580a0f8ea7a7fdb728140ae978d
_srcdir="qrtr-$_commit"
source=("$pkgname-$_commit.tar.gz::https://github.com/linux-msm/qrtr/archive/$_commit.tar.gz")
sha256sums=('SKIP')

build() {
	cd "$srcdir/$_srcdir"
	arch-meson . build
	meson compile -C build
}

package() {
	cd "$srcdir/$_srcdir"
	meson install -C build --destdir "$pkgdir"
}
