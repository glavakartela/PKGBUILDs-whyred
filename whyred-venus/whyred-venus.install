post_install() {
	cat <<'EOF'
Enable the Venus services:

  systemctl --user enable --now venus-video.service venus-clipboard.service
  sudo systemctl enable --now venus-firefox-bookmark.service

The bookmarklet appears in Firefox after a restart.  Copied YouTube/Vimeo
URLs are sent to the local Venus service automatically.
EOF
}

post_upgrade() {
	post_install
}
