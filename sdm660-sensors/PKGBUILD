pkgname=sdm660-sensors
pkgver=1
pkgrel=1
pkgdesc="Qualcomm Sensor Core support for the Xiaomi Redmi Note 5 Pro"
arch=('aarch64')
url="https://github.com/glavakartela/PKGBUILDs-whyred"
license=('MIT')
depends=('libssc' 'iio-sensor-proxy')
source=('81-sdm660-sensors.rules' 'sdm660-sensors.conf')
sha256sums=('2cf7cd2f92cbcb572f5e8519fc36913a0bb968eba4b52be65e324dde5d85a892'
            '27157651042a58c4121c468fa594ae15d09f4588b5d348ed0a28bd037ecfc662')

package() {
  install -Dm644 "$srcdir/81-sdm660-sensors.rules" \
    "$pkgdir/usr/lib/udev/rules.d/81-sdm660-sensors.rules"
  install -Dm644 "$srcdir/sdm660-sensors.conf" \
    "$pkgdir/usr/lib/modules-load.d/sdm660-sensors.conf"
}
