#!/usr/bin/env python3
"""Install (or refresh) the Venus bookmarklet in Firefox enterprise policies.

Firefox reads /etc/firefox/policies/policies.json at startup and creates the
managed bookmark automatically.  The policy survives Firefox updates and is
re-applied at every boot by venus-firefox-bookmark.service.
"""
import json
import os

PATH = "/etc/firefox/policies/policies.json"
TITLE = "Play with Venus"
URL = ("javascript:location.href='http://127.0.0.1:8765/play?url='"
       "+encodeURIComponent(location.href)")

data = {}
if os.path.exists(PATH):
    try:
        with open(PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        data = {}

policies = data.setdefault("policies", {})
bookmarks = policies.get("Bookmarks")
if not isinstance(bookmarks, list):
    bookmarks = []

bookmarks = [b for b in bookmarks
             if not (isinstance(b, dict) and b.get("Title") == TITLE)]
bookmarks.append({
    "Title": TITLE,
    "URL": URL,
    "Placement": "menu",
})
policies["Bookmarks"] = bookmarks

os.makedirs(os.path.dirname(PATH), exist_ok=True)
tmp = PATH + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.replace(tmp, PATH)
print(f"installed {TITLE} in {PATH}")
